<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>Rixl.Sdk</PackageId>
    <Version>0.1.3</Version>
    <Authors>RIXL</Authors>
    <Company>RIXL</Company>
    <Description>C# client for the RIXL API.</Description>
    <PackageProjectUrl>https://github.com/rixlhq/rixl-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rixlhq/rixl-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>rixl;sdk;api;video;media</PackageTags>

    <RootNamespace>Rixl.Sdk</RootNamespace>
    <AssemblyName>Rixl.Sdk</AssemblyName>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.22.1"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
    <None Include="..\LICENSE" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
